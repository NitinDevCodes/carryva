<%- include('./partials/header') %>
<main id="main-content" class="page-shell shell">
    <div class="page-heading"><div><p class="eyebrow">Your Carryva purchases</p><h1>Your orders</h1><p>Order updates and details, all in one place.</p></div><a class="inline-link" href="/shop">Explore the collection</a></div>
    <% if (error) { %><p role="alert" class="page-alert page-alert-error"><%= error %></p>
    <% } else if (!orders.length) { %><section class="empty-state"><p class="eyebrow">Your next favourite is out there</p><h2>No orders yet</h2><p>Your orders will appear here after checkout.</p><a href="/shop" class="button button-dark">Explore the collection</a></section>
    <% } else { %><div class="order-list"><% orders.forEach(function(order) { %>
        <a href="/orders/<%= order._id %>" class="order-row"><div><p class="eyebrow">Placed <%= new Date(order.createdAt).toLocaleDateString() %></p><h2>Order #<%= String(order._id).slice(-8).toUpperCase() %></h2><p><%= order.items.length %> item(s)</p></div><div class="order-row-meta"><span class="status-pill status-<%= order.status %>"><%= order.status %></span><strong>₹ <%= order.total.toFixed(2) %></strong></div></a>
    <% }) %></div><% } %>
</main>
<%- include('./partials/footer') %>
