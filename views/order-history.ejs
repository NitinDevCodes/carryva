<%- include('./partials/header') %>
<main class="min-h-screen px-5 pb-16 pt-24 md:px-10"><div class="mx-auto max-w-5xl">
    <div class="mb-8"><p class="text-sm uppercase tracking-wide text-zinc-500">Your Carryva purchases</p><h1 class="text-3xl font-semibold">Your orders</h1></div>
    <% if (error) { %><p role="alert" class="rounded bg-red-100 p-4 text-red-800"><%= error %></p>
    <% } else if (!orders.length) { %><section class="rounded-lg border bg-white p-10 text-center"><h2 class="text-xl font-medium">No orders yet</h2><p class="mt-2 text-zinc-600">Your orders will appear here after checkout.</p><a href="/shop" class="mt-6 inline-block rounded-full bg-zinc-900 px-6 py-3 text-white">Explore the collection</a></section>
    <% } else { %><div class="space-y-4"><% orders.forEach(function(order) { %>
        <a href="/orders/<%= order._id %>" class="block rounded-lg border bg-white p-5 transition hover:border-zinc-500 sm:flex sm:items-center sm:justify-between">
            <div><p class="font-semibold">Order #<%= String(order._id).slice(-8).toUpperCase() %></p><p class="mt-1 text-sm text-zinc-600"><%= new Date(order.createdAt).toLocaleDateString() %> · <%= order.items.length %> item(s)</p></div>
            <div class="mt-3 flex items-center gap-5 sm:mt-0"><span class="rounded-full bg-zinc-100 px-3 py-1 text-sm capitalize"><%= order.status %></span><strong>₹ <%= order.total.toFixed(2) %></strong></div>
        </a>
    <% }) %></div><% } %>
</div></main>
<%- include('./partials/footer') %>
