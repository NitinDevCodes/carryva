<%- include('./partials/header') %>
<main id="main-content" class="page-shell shell">
    <div class="page-heading"><div><p class="eyebrow">Owner workspace</p><h1>Products</h1><p>Manage the Carryva catalog.</p></div><div class="owner-toolbar"><a class="button button-outline" href="/owners/orders">Manage orders</a><a class="button button-dark" href="/owners/createproducts">Create new product</a></div></div>
    <% success.forEach(function(message) { %><p role="status" class="page-alert page-alert-success"><%= message %></p><% }) %>
    <% if (error) { %><p role="alert" class="page-alert page-alert-error"><%= error %></p>
    <% } else if (products.length === 0) { %><section class="empty-state"><p class="eyebrow">The collection begins here</p><h2>No products have been added yet.</h2><a class="button button-dark" href="/owners/createproducts">Create a product</a></section>
    <% } else { %><div class="owner-product-grid"><% products.forEach(function(product) { %><article class="owner-product-card"><a href="/products/<%= product._id %>" class="owner-product-image"><img src="data:<%= product.imageContentType %>;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>"></a><div class="owner-product-meta"><div><h2><%= product.name %></h2><p>₹ <%= product.price.toFixed(2) %></p></div><div class="owner-product-actions"><a class="button button-outline" href="/products/<%= product._id %>/edit">Edit</a><form action="/products/<%= product._id %>/delete" method="post" data-confirm="Delete this product?"><button class="button danger-button" type="submit">Delete</button></form></div></div></article><% }) %></div><% } %>
</main>
<%- include('./partials/footer') %>
