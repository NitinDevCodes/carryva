<%- include('./partials/header') %>
<main class="min-h-screen px-6 py-20 md:px-20">
    <div class="mx-auto max-w-7xl">
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-semibold">Products</h1>
                <p class="text-zinc-600">Manage the Carryva catalog.</p>
            </div>
            <div class="flex flex-wrap gap-3"><a class="rounded border px-5 py-3" href="/owners/orders">Manage orders</a><a class="rounded bg-blue-500 px-5 py-3 text-white" href="/owners/createproducts">Create new product</a></div>
        </div>
        <% success.forEach(function(message) { %><p class="mb-4 rounded bg-blue-100 p-3 text-blue-800"><%= message %></p><% }) %>
        <% if (error) { %>
            <p class="rounded bg-red-100 p-4 text-red-800"><%= error %></p>
        <% } else if (products.length === 0) { %>
            <p class="rounded bg-zinc-100 p-6 text-zinc-700">No products have been added yet.</p>
        <% } else { %>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                <% products.forEach(function(product) { %>
                    <article class="overflow-hidden rounded-md border">
                        <a href="/products/<%= product._id %>">
                            <div class="flex h-52 items-center justify-center" style="background-color: <%= product.bgColor %>">
                                <img class="h-48 max-w-full object-contain" src="data:<%= product.imageContentType %>;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                            </div>
                        </a>
                        <div class="flex items-center justify-between gap-3 p-4">
                            <div><h2 class="font-medium"><%= product.name %></h2><p>₹ <%= product.price.toFixed(2) %></p></div>
                            <div class="flex gap-2">
                                <a class="rounded border px-3 py-2" href="/products/<%= product._id %>/edit">Edit</a>
                                <form action="/products/<%= product._id %>/delete" method="post" onsubmit="return confirm('Delete this product?')">
                                    <button class="rounded bg-red-600 px-3 py-2 text-white" type="submit">Delete</button>
                                </form>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </div>
</main>
<%- include('./partials/footer') %>
