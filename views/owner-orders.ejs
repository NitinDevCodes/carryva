<%- include('./partials/header') %>
<main id="main-content" class="page-shell shell">
    <div class="page-heading"><div><p class="eyebrow">Owner workspace</p><h1>Orders</h1><p>Review customer orders and fulfilment status.</p></div><a class="inline-link" href="/owners/admin">Product management</a></div>
    <% if (error) { %><p role="alert" class="page-alert page-alert-error"><%= error %></p><% } else if (!orders.length) { %><section class="empty-state"><p class="eyebrow">All caught up</p><h2>No orders have been placed yet.</h2></section><% } else { %>
        <div class="owner-table-wrap"><table class="owner-table"><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Status</th><th>Total</th></tr></thead><tbody><% orders.forEach(function(order) { %><tr><td><a href="/owners/orders/<%= order._id %>">#<%= String(order._id).slice(-8).toUpperCase() %></a></td><td><%= order.deliveryAddress.customerName %></td><td><%= new Date(order.createdAt).toLocaleDateString() %></td><td><span class="status-pill status-<%= order.status %>"><%= order.status %></span></td><td>₹ <%= order.total.toFixed(2) %></td></tr><% }) %></tbody></table></div>
    <% } %>
</main>
<%- include('./partials/footer') %>
