<%- include('./partials/header') %>
<main class="min-h-screen px-5 pb-16 pt-24 md:px-10"><div class="mx-auto max-w-6xl">
    <div class="mb-8"><p class="text-sm uppercase tracking-wide text-zinc-500">Owner workspace</p><h1 class="text-3xl font-semibold">Orders</h1></div>
    <% if (error) { %><p role="alert" class="rounded bg-red-100 p-4 text-red-800"><%= error %></p><% } else if (!orders.length) { %><p class="rounded-lg border bg-white p-8 text-zinc-600">No orders have been placed yet.</p><% } else { %>
    <div class="overflow-x-auto rounded-lg border bg-white"><table class="w-full min-w-[42rem] text-left text-sm"><thead class="border-b bg-zinc-50"><tr><th class="p-4">Order</th><th class="p-4">Customer</th><th class="p-4">Date</th><th class="p-4">Status</th><th class="p-4">Total</th></tr></thead><tbody><% orders.forEach(function(order) { %><tr class="border-b last:border-0"><td class="p-4"><a class="underline" href="/owners/orders/<%= order._id %>">#<%= String(order._id).slice(-8).toUpperCase() %></a></td><td class="p-4"><%= order.deliveryAddress.customerName %></td><td class="p-4"><%= new Date(order.createdAt).toLocaleDateString() %></td><td class="p-4 capitalize"><%= order.status %></td><td class="p-4">₹ <%= order.total.toFixed(2) %></td></tr><% }) %></tbody></table></div>
    <% } %>
</div></main>
<%- include('./partials/footer') %>
