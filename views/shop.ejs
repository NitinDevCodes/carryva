<%- include('./partials/header') %>
<main id="main-content" class="shop-page shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Shop</span></nav>
    <div class="shop-heading"><div><p class="eyebrow eyebrow-accent">The Carryva collection</p><h1>Bags to go with you</h1><p class="shop-subtitle">An easy edit of bags for workdays, weekends, and everything between.</p></div><p class="result-count"><%= products.length %> <%= products.length === 1 ? 'style' : 'styles' %><% if (category) { %> · <%= category %><% } %></p></div>
    <% if (error) { %><p class="page-alert page-alert-error" role="alert"><%= error %></p><% } %>
    <div class="shop-layout">
        <aside class="shop-sidebar" aria-label="Shop filters">
            <div class="filter-block"><h2>Collections</h2><nav class="filter-links" aria-label="Collections">
                <a class="<%= filter === 'all' && !category ? 'is-current' : '' %>" href="/shop">All bags <span>→</span></a>
                <a class="<%= filter === 'new' ? 'is-current' : '' %>" href="/shop?filter=new<%= category ? `&category=${encodeURIComponent(category)}` : '' %>">New arrivals <span>→</span></a>
                <a class="<%= filter === 'discounted' ? 'is-current' : '' %>" href="/shop?filter=discounted<%= category ? `&category=${encodeURIComponent(category)}` : '' %>">The edit <span>→</span></a>
            </nav></div>
            <% if (categories.length) { %><div class="filter-block"><h2>Shop by type</h2><nav class="filter-links" aria-label="Categories">
                <% categories.forEach(function(item) { %><a class="<%= category === item ? 'is-current' : '' %>" href="/shop?category=<%= encodeURIComponent(item) %><%= filter !== 'all' ? `&filter=${encodeURIComponent(filter)}` : '' %>"><%= item %><span>→</span></a><% }) %>
            </nav></div><% } %>
            <form action="/shop" method="get" class="sort-form">
                <% if (filter !== 'all') { %><input type="hidden" name="filter" value="<%= filter %>"><% } %>
                <% if (category) { %><input type="hidden" name="category" value="<%= category %>"><% } %>
                <label for="sortby">Sort by</label>
                <select name="sortby" id="sortby" data-auto-submit>
                    <option value="newest" <%= sortby === 'newest' ? 'selected' : '' %>>Recently added</option>
                    <option value="price-low" <%= sortby === 'price-low' ? 'selected' : '' %>>Price: low to high</option>
                    <option value="price-high" <%= sortby === 'price-high' ? 'selected' : '' %>>Price: high to low</option>
                </select>
            </form>
        </aside>
        <section class="shop-results" aria-live="polite" aria-label="Products">
            <% if (!error && products.length === 0) { %><div class="empty-state"><p class="eyebrow">Nothing here yet</p><h2>No bags match this selection.</h2><p>No products match this view yet. Try another collection or browse all bags.</p><a class="button button-outline" href="/shop">View all bags</a></div>
            <% } else if (products.length) { %><div class="product-grid"><% products.forEach(function(product) { %><%- include('./partials/product-card', { product }) %><% }) %></div><% } %>
        </section>
    </div>
</main>
<%- include('./partials/footer') %>
