<%- include('./partials/header') %>
<main class="min-h-screen px-5 pb-16 pt-24 md:px-10"><div class="mx-auto max-w-3xl">
    <section class="rounded-lg border bg-white p-6 text-center sm:p-10">
        <p class="text-sm uppercase tracking-wide text-green-700">Order placed</p><h1 class="mt-2 text-3xl font-semibold">Thank you, <%= order.deliveryAddress.customerName %></h1>
        <p class="mt-3 text-zinc-600">Your order <strong>#<%= String(order._id).slice(-8).toUpperCase() %></strong> is confirmed. Payment is <strong>pending</strong>; this order uses cash on delivery.</p>
        <p class="mt-2 text-sm text-zinc-600">We have not processed an online payment.</p>
        <a href="/orders/<%= order._id %>" class="mt-6 inline-block rounded-full bg-zinc-900 px-6 py-3 text-white">View order details</a>
    </section>
</div></main>
<%- include('./partials/footer') %>
