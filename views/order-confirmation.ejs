<%- include('./partials/header') %>
<main id="main-content" class="page-shell shell">
    <section class="confirmation-card"><div class="confirmation-mark" aria-hidden="true">✓</div><p class="eyebrow eyebrow-accent">Order placed</p><h1>Thank you, <%= order.deliveryAddress.customerName %></h1>
        <p>Your order <strong>#<%= String(order._id).slice(-8).toUpperCase() %></strong> is confirmed. Payment is <strong>pending</strong>; this order uses cash on delivery.</p><p>We have not processed an online payment.</p>
        <div class="confirmation-actions"><a href="/orders/<%= order._id %>" class="button button-dark">View order details</a><a href="/shop" class="button button-outline">Continue shopping</a></div>
    </section>
</main>
<%- include('./partials/footer') %>
