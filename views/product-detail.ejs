<%- include('./partials/header') %>
<main id="main-content" class="product-detail-page shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/shop">Shop</a><span aria-hidden="true">/</span><span><%= product ? product.name : 'Product' %></span></nav>
    <% if (error) { %><section class="empty-state page-alert" role="status"><p class="eyebrow">Carryva collection</p><h1><%= error %></h1><a class="button button-outline" href="/shop">Back to the collection</a></section>
    <% } else { %>
        <% const gallery = [{ data: product.image, contentType: product.imageContentType }, ...(product.images || [])]; %>
        <% const salePrice = product.discountedPrice != null ? product.discountedPrice : product.price * (1 - (product.discount || 0) / 100); %>
        <% const hasDiscount = salePrice < product.price; %>
        <% const canAdd = (product.availability || 'in-stock') === 'in-stock' && (product.stockQuantity ?? 1) > 0; %>
        <article class="product-detail-layout">
            <section class="gallery-column" aria-label="Product images">
                <div class="main-product-image">
                    <div class="image-wash"></div>
                    <img id="primary-product-image" src="data:<%= gallery[0].contentType %>;base64,<%= gallery[0].data.toString('base64') %>" alt="<%= product.name %>">
                    <% if (hasDiscount) { %><span class="badge badge-sale detail-sale-badge"><%= Math.round((1 - salePrice / product.price) * 100) %>% off</span><% } %>
                </div>
                <% if (gallery.length > 1) { %><div class="gallery-thumbnails" role="group" aria-label="Choose product image"><% gallery.forEach(function(image, index) { %>
                    <button class="gallery-thumb <%= index === 0 ? 'is-active' : '' %>" type="button" data-gallery-src="data:<%= image.contentType %>;base64,<%= image.data.toString('base64') %>" data-gallery-alt="<%= product.name %>, image <%= index + 1 %>" aria-label="Show image <%= index + 1 %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>"><img src="data:<%= image.contentType %>;base64,<%= image.data.toString('base64') %>" alt=""></button>
                <% }) %></div><% } %>
            </section>
            <section class="product-purchase-panel">
                <p class="eyebrow eyebrow-accent"><%= product.category || 'Other' %><% if (product.isNewCollection) { %><span aria-hidden="true"> · </span>New arrival<% } %></p>
                <h1><%= product.name %></h1>
                <div class="detail-price"><% if (hasDiscount) { %><del>₹ <%= product.price.toFixed(2) %></del><% } %><strong>₹ <%= salePrice.toFixed(2) %></strong><% if (hasDiscount) { %><span class="badge badge-sale"><%= Math.round((1 - salePrice / product.price) * 100) %>% off</span><% } %></div>
                <p class="detail-description"><%= product.description || 'A Carryva bag for everyday plans.' %></p>
                <div class="availability-line"><span class="availability-dot <%= canAdd ? 'is-available' : 'is-unavailable' %>"></span><span><%= canAdd ? `${product.stockQuantity ?? 1} available` : (product.availability === 'preorder' ? 'Available for pre-order' : 'Currently unavailable') %></span></div>
                <form action="/cart/items/<%= product._id %>" method="post" class="purchase-form">
                    <label for="quantity">Quantity</label><div class="purchase-actions"><input id="quantity" name="quantity" type="number" value="1" min="1" max="<%= product.stockQuantity ?? 1 %>" <%= canAdd ? '' : 'disabled' %> required><button class="button button-dark" type="submit" <%= canAdd ? '' : 'disabled' %>>Add to bag</button></div>
                </form>
                <div class="detail-rule"></div>
                <section class="details-section"><h2>Details</h2><dl class="product-spec-list">
                    <dt>Category</dt><dd><%= product.category || 'Other' %></dd>
                    <dt>Colour</dt><dd><%= product.colour && product.colour !== 'Not specified' ? product.colour : 'Not specified' %></dd>
                    <dt>Material</dt><dd><%= product.material && product.material !== 'Not specified' ? product.material : 'Not specified' %></dd>
                    <dt>Dimensions</dt><dd><%= product.dimensions || 'Not specified' %></dd>
                    <dt>Capacity</dt><dd><%= product.capacity || 'Not specified' %></dd>
                    <dt>Weight</dt><dd><%= product.weight != null ? `${product.weight} g` : 'Not specified' %></dd>
                    <dt>Availability</dt><dd><%= (product.availability || 'in-stock') === 'in-stock' ? 'In stock' : (product.availability === 'preorder' ? 'Pre-order' : 'Out of stock') %></dd>
                </dl></section>
                <% if ((product.features || []).length) { %><section class="details-section"><h2>Features</h2><ul class="feature-list"><% product.features.forEach(function(feature) { %><li><span aria-hidden="true">✳</span><%= feature %></li><% }) %></ul></section><% } %>
                <% if (product.careInstructions || product.warranty) { %><details class="care-details"><summary>Care &amp; warranty information</summary><div><% if (product.careInstructions) { %><p><strong>Care:</strong> <%= product.careInstructions %></p><% } %><% if (product.warranty) { %><p><strong>Warranty:</strong> <%= product.warranty %></p><% } %></div></details><% } %>
            </section>
        </article>
    <% } %>
</main>
<%- include('./partials/footer') %>
