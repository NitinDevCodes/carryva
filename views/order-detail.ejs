<%- include('./partials/header') %>
<main class="min-h-screen px-5 pb-16 pt-24 md:px-10"><div class="mx-auto max-w-5xl">
    <a href="/orders" class="text-sm underline">← Your orders</a>
    <div class="mb-7 mt-4 flex flex-wrap items-end justify-between gap-3"><div><p class="text-sm uppercase tracking-wide text-zinc-500">Order #<%= String(order._id).slice(-8).toUpperCase() %></p><h1 class="text-3xl font-semibold">Order details</h1></div><span class="rounded-full bg-zinc-100 px-4 py-2 capitalize"><%= order.status %></span></div>
    <div class="grid gap-7 lg:grid-cols-[1fr_20rem]">
        <section class="space-y-3"><% order.items.forEach(function(item) { %><article class="flex gap-4 rounded-lg border bg-white p-4"><img class="h-24 w-24 rounded bg-zinc-50 object-contain p-2" src="data:<%= item.imageContentType %>;base64,<%= item.image.toString('base64') %>" alt=""><div class="flex-1"><h2 class="font-medium"><%= item.name %></h2><p class="mt-1 text-sm text-zinc-600">Quantity: <%= item.quantity %> · Unit price: ₹ <%= item.unitPrice.toFixed(2) %></p><p class="mt-1 text-sm">Line total: ₹ <%= (item.unitPrice * item.quantity).toFixed(2) %></p></div></article><% }) %></section>
        <aside class="h-fit rounded-lg border bg-white p-5"><h2 class="font-semibold">Delivery and payment</h2><p class="mt-3"><%= order.deliveryAddress.customerName %></p><p><%= order.deliveryAddress.phone %></p><p class="mt-2 text-sm text-zinc-600"><%= order.deliveryAddress.address %>, <%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %> <%= order.deliveryAddress.postalCode %></p><p class="mt-4 text-sm"><strong>Cash on delivery</strong><br>Payment status: <%= order.paymentStatus === 'paid' ? 'Paid' : 'Pending on delivery' %></p><dl class="mt-5 space-y-2 border-t pt-4 text-sm"><div class="flex justify-between"><dt>Subtotal</dt><dd>₹ <%= order.subtotal.toFixed(2) %></dd></div><div class="flex justify-between"><dt>Discount</dt><dd>− ₹ <%= order.discount.toFixed(2) %></dd></div><div class="flex justify-between"><dt>Delivery</dt><dd><%= order.deliveryFee === 0 ? 'Free' : `₹ ${order.deliveryFee.toFixed(2)}` %></dd></div><div class="flex justify-between border-t pt-3 text-base font-semibold"><dt>Total</dt><dd>₹ <%= order.total.toFixed(2) %></dd></div></dl></aside>
    </div>
</div></main>
<%- include('./partials/footer') %>
