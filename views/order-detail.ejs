<%- include('./partials/header') %>
<main id="main-content" class="page-shell shell">
    <a href="/orders" class="inline-link">← Your orders</a>
    <div class="page-heading order-title"><div><p class="eyebrow">Order #<%= String(order._id).slice(-8).toUpperCase() %></p><h1>Order details</h1></div><span class="status-pill status-<%= order.status %>"><%= order.status %></span></div>
    <div class="order-detail-grid"><section class="order-products" aria-label="Items in this order"><% order.items.forEach(function(item) { %><article class="order-product"><img src="data:<%= item.imageContentType %>;base64,<%= item.image.toString('base64') %>" alt=""><div><h2><%= item.name %></h2><p>Quantity: <%= item.quantity %> · Unit price: ₹ <%= item.unitPrice.toFixed(2) %></p></div><strong>₹ <%= (item.unitPrice * item.quantity).toFixed(2) %></strong></article><% }) %></section>
        <aside class="summary-card"><h2>Delivery and payment</h2><address class="delivery-address"><strong><%= order.deliveryAddress.customerName %></strong><br><%= order.deliveryAddress.phone %><br><%= order.deliveryAddress.address %><br><%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %> <%= order.deliveryAddress.postalCode %></address><p class="payment-status"><strong>Cash on delivery</strong><br>Payment status: <%= order.paymentStatus === 'paid' ? 'Paid' : 'Pending on delivery' %></p><dl class="summary-lines"><div><dt>Subtotal</dt><dd>₹ <%= order.subtotal.toFixed(2) %></dd></div><div class="discount-line"><dt>Discount</dt><dd>− ₹ <%= order.discount.toFixed(2) %></dd></div><div><dt>Delivery</dt><dd><%= order.deliveryFee === 0 ? 'Free' : `₹ ${order.deliveryFee.toFixed(2)}` %></dd></div><div class="summary-total"><dt>Total</dt><dd>₹ <%= order.total.toFixed(2) %></dd></div></dl></aside>
    </div>
</main>
<%- include('./partials/footer') %>
