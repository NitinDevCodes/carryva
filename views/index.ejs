<%- include('./partials/header') %>

    <% if(error.length>0){ %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 -translate-y-1/2 p-3 rounded-md bg-red-500">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= error %>
            </span>
        </div>
        <% } %>
            <div class="w-full h-screen flex px-20">
                <div class="w-1/2 flex items-center justify-center h-screen">
                    <div class="w-full px-32">
                        <h3 class="text-4xl">welcome to <span class="text-blue-400 font-semibold">Carryva</span></h3>
                        <h4 class="text-2xl mb-5">create your account</h4>
                        <form autocomplete="off" action="/users/register" method="post">
                            <input type="hidden" name="returnTo" value="<%= returnTo %>">
                            <input
                                class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="text" placeholder="Full Name" name="fullName" minlength="3" maxlength="80" required autocomplete="name">
                            <input
                                class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="email" placeholder="Email" name="email" maxlength="254" required autocomplete="email">
                            <input
                                class="bg-zinc-100 block w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="password" placeholder="Password" name="password" minlength="8" maxlength="72" required autocomplete="new-password">
                            <input class="px-5 rounded-full py-3 mt-2 bg-blue-500 text-white" type="submit"
                                value="Create My Account">
                        </form>
                    </div>
                </div>
                <div class="w-1/2 flex items-center justify-center h-screen">
                    <div class="w-full px-32">
                        <h4 class="text-2xl capitalize mb-5">login your account</h4>
                        <form autocomplete="off" action="/users/login" method="post">
                            <input type="hidden" name="returnTo" value="<%= returnTo %>">
                            <input
                                class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="email" placeholder="Email" name="email" maxlength="254" required autocomplete="username">
                            <input
                                class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                                type="password" placeholder="Password" name="password" required autocomplete="current-password">
                            <input class="px-5 block rounded-full py-3 mt-2 bg-blue-500 text-white" type="submit"
                                value="Login">
                        </form>
                    </div>
                </div>
            </div>
            <section class="mx-auto max-w-7xl px-6 py-12 md:px-20" aria-labelledby="featured-products-heading">
                <div class="mb-6 flex items-end justify-between gap-4">
                    <div>
                        <p class="text-sm uppercase tracking-wide text-zinc-500">Carryva selection</p>
                        <h2 id="featured-products-heading" class="text-2xl font-semibold">Featured bags</h2>
                    </div>
                    <a class="underline" href="/shop">Shop all bags</a>
                </div>
                <% if (productError) { %>
                    <p class="rounded bg-red-100 p-4 text-red-800"><%= productError %></p>
                <% } else if (featuredProducts.length === 0) { %>
                    <p class="text-zinc-600">Our featured collection is being curated.</p>
                <% } else { %>
                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
                        <% featuredProducts.forEach(function(product) { %>
                            <% const salePrice = product.discountedPrice != null ? product.discountedPrice : product.price * (1 - (product.discount || 0) / 100); %>
                            <% const canAdd = (product.availability || 'in-stock') === 'in-stock' && (product.stockQuantity ?? 1) > 0; %>
                            <article class="overflow-hidden rounded-md border">
                            <a class="block" href="/products/<%= product._id %>">
                                <div class="flex h-48 items-center justify-center" style="background-color: <%= product.bgColor || '#f4f4f4' %>">
                                    <img class="h-44 max-w-full object-contain" src="data:<%= product.imageContentType %>;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                                </div>
                                <div class="p-4">
                                    <p class="text-sm text-zinc-500"><%= product.category || 'Other' %></p>
                                    <h3 class="font-medium"><%= product.name %></h3>
                                    <p><% if (salePrice < product.price) { %><del>₹ <%= product.price.toFixed(2) %></del> <% } %><strong>₹ <%= salePrice.toFixed(2) %></strong></p>
                                </div>
                            </a>
                            <form action="/cart/items/<%= product._id %>" method="post" class="flex items-center justify-between border-t p-3">
                                <input type="hidden" name="quantity" value="1">
                                <span class="text-xs text-zinc-600"><%= canAdd ? `${product.stockQuantity ?? 1} available` : 'Unavailable' %></span>
                                <button type="submit" <%= canAdd ? '' : 'disabled' %> class="rounded-full bg-zinc-900 px-4 py-2 text-sm text-white disabled:cursor-not-allowed disabled:opacity-40">Add to cart</button>
                            </form>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>
            <%- include('./partials/footer') %>
