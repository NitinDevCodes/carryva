<%- include('./partials/header') %>
<main class="min-h-screen px-6 py-24 md:px-20">
    <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex items-end justify-between gap-4">
            <div>
                <p class="text-sm uppercase tracking-wide text-zinc-500">Your selection</p>
                <h1 class="text-3xl font-semibold">Shopping cart</h1>
            </div>
            <a href="/shop" class="underline">Continue shopping</a>
        </div>
        <% error.forEach(function(message) { %><p role="alert" class="mb-3 rounded bg-red-100 p-4 text-red-800"><%= message %></p><% }) %>
        <% success.forEach(function(message) { %><p role="status" class="mb-3 rounded bg-green-100 p-4 text-green-800"><%= message %></p><% }) %>
        <% if (items.length === 0) { %>
            <section class="rounded-lg border bg-white p-10 text-center">
                <h2 class="text-xl font-medium">Your cart is empty</h2>
                <p class="mt-2 text-zinc-600">Explore the collection and find a bag for every day.</p>
                <a href="/shop" class="mt-6 inline-block rounded-full bg-zinc-900 px-6 py-3 text-white">Browse bags</a>
            </section>
        <% } else { %>
            <div class="grid gap-8 lg:grid-cols-[1fr_20rem]">
                <section class="space-y-4" aria-label="Cart items">
                    <% items.forEach(function(item) { %>
                        <% const product = item.product; %>
                        <% const canIncrement = item.available && item.quantity < item.stockQuantity; %>
                        <article class="grid gap-5 rounded-lg border bg-white p-4 sm:grid-cols-[9rem_1fr]">
                            <a href="/products/<%= item.productId %>" class="flex h-36 items-center justify-center rounded bg-zinc-50 p-3">
                                <img class="max-h-full max-w-full object-contain" src="data:<%= product.imageContentType %>;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                            </a>
                            <div class="flex flex-col justify-between gap-4">
                                <div class="flex flex-wrap items-start justify-between gap-3">
                                    <div>
                                        <p class="text-sm text-zinc-500"><%= product.category || 'Other' %></p>
                                        <h2 class="text-lg font-medium"><a href="/products/<%= item.productId %>"><%= product.name %></a></h2>
                                        <p class="mt-1 text-sm text-zinc-600"><% if (item.unitPrice < item.regularPrice) { %><del>₹ <%= item.regularPrice.toFixed(2) %></del> <% } %>₹ <%= item.unitPrice.toFixed(2) %> each</p>
                                    </div>
                                    <form action="/cart/items/<%= item.productId %>/remove" method="post">
                                        <button class="text-sm underline text-zinc-600" type="submit">Remove</button>
                                    </form>
                                </div>
                                <% if (!item.available) { %>
                                    <p role="alert" class="rounded bg-amber-50 p-3 text-sm text-amber-900">
                                        <% if (item.availability !== 'in-stock' || item.stockQuantity === 0) { %>This bag is currently unavailable.<% } else { %>Only <%= item.stockQuantity %> are available. Update the quantity to continue.<% } %>
                                    </p>
                                <% } %>
                                <div class="flex flex-wrap items-end justify-between gap-4">
                                    <div>
                                        <div class="flex items-center gap-3">
                                            <form action="/cart/items/<%= item.productId %>/decrement" method="post">
                                                <button type="submit" aria-label="Decrease <%= product.name %> quantity" class="h-9 w-9 rounded-full border">−</button>
                                            </form>
                                            <span class="min-w-6 text-center font-medium" aria-label="Quantity"><%= item.quantity %></span>
                                            <form action="/cart/items/<%= item.productId %>/increment" method="post">
                                                <button type="submit" aria-label="Increase <%= product.name %> quantity" <%= canIncrement ? '' : 'disabled' %> class="h-9 w-9 rounded-full border disabled:opacity-40">+</button>
                                            </form>
                                        </div>
                                        <% if (item.availability === 'in-stock' && item.stockQuantity > 0) { %>
                                            <form action="/cart/items/<%= item.productId %>/quantity" method="post" class="mt-2 flex items-center gap-2">
                                                <label class="text-xs text-zinc-600">Available: <%= item.stockQuantity %></label>
                                                <input name="quantity" type="number" value="<%= item.quantity %>" min="1" max="<%= item.stockQuantity %>" class="w-20 rounded border px-2 py-1 text-sm">
                                                <button type="submit" class="text-xs underline">Update</button>
                                            </form>
                                        <% } %>
                                    </div>
                                    <p class="text-right"><span class="block text-xs text-zinc-500">Line total</span><strong>₹ <%= item.lineTotal.toFixed(2) %></strong></p>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </section>
                <aside class="h-fit rounded-lg border bg-white p-6">
                    <h2 class="text-lg font-semibold">Price summary</h2>
                    <dl class="mt-5 space-y-3 text-sm">
                        <div class="flex justify-between gap-4"><dt>Subtotal</dt><dd>₹ <%= totals.subtotal.toFixed(2) %></dd></div>
                        <div class="flex justify-between gap-4 text-green-700"><dt>Total discount</dt><dd>− ₹ <%= totals.totalDiscount.toFixed(2) %></dd></div>
                        <div class="border-t pt-3 text-base font-semibold flex justify-between gap-4"><dt>Total</dt><dd>₹ <%= totals.total.toFixed(2) %></dd></div>
                    </dl>
                    <% if (items.every(function(item) { return item.available; })) { %>
                        <a href="/checkout" class="mt-6 block rounded-full bg-zinc-900 px-5 py-3 text-center font-medium text-white">Continue to checkout</a>
                    <% } else { %>
                        <p class="mt-5 rounded bg-amber-50 p-3 text-sm text-amber-900">Update unavailable quantities before checkout.</p>
                    <% } %>
                    <p class="mt-4 text-xs leading-relaxed text-zinc-500">Prices use the latest product details. Availability and stock are checked again when you change quantities.</p>
                </aside>
            </div>
        <% } %>
    </div>
</main>
<%- include('./partials/footer') %>
