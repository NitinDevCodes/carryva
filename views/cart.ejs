<%- include('./partials/header') %>
<main id="main-content" class="page-shell shell">
    <div class="page-heading"><div><p class="eyebrow">Your selection</p><h1>Your shopping bag</h1><p>Thoughtful pieces, ready for wherever the day takes you.</p></div><a class="inline-link" href="/shop">Continue shopping</a></div>
    <% error.forEach(function(message) { %><p role="alert" class="page-alert page-alert-error"><%= message %></p><% }) %>
    <% success.forEach(function(message) { %><p role="status" class="page-alert page-alert-success"><%= message %></p><% }) %>
    <% if (items.length === 0) { %>
        <section class="empty-state"><p class="eyebrow">A fresh start</p><h2>Your cart is empty</h2><p>Explore the collection and find a bag for every day.</p><a href="/shop" class="button button-dark">Browse bags</a></section>
    <% } else { %>
        <div class="cart-layout"><section class="cart-list" aria-label="Cart items">
            <% items.forEach(function(item) { %><% const product = item.product; %><% const canIncrement = item.available && item.quantity < item.stockQuantity; %>
                <article class="cart-item">
                    <a href="/products/<%= item.productId %>" class="cart-item-image"><img src="data:<%= product.imageContentType %>;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>"></a>
                    <div class="cart-item-content"><div class="cart-item-top"><div><p class="eyebrow"><%= product.category || 'Bag' %></p><h2><a href="/products/<%= item.productId %>"><%= product.name %></a></h2><p class="cart-unit-price"><% if (item.unitPrice < item.regularPrice) { %><del>₹ <%= item.regularPrice.toFixed(2) %></del> <% } %>₹ <%= item.unitPrice.toFixed(2) %> each</p></div><form action="/cart/items/<%= item.productId %>/remove" method="post"><button class="remove-button" type="submit">Remove</button></form></div>
                        <% if (!item.available) { %><p role="alert" class="stock-warning"><% if (item.availability !== 'in-stock' || item.stockQuantity === 0) { %>This bag is currently unavailable.<% } else { %>Only <%= item.stockQuantity %> are available. Update the quantity to continue.<% } %></p><% } %>
                        <div class="cart-item-bottom"><div><div class="cart-controls"><form action="/cart/items/<%= item.productId %>/decrement" method="post"><button type="submit" aria-label="Decrease <%= product.name %> quantity" class="quantity-button">−</button></form><span class="quantity-value" aria-label="Quantity"><%= item.quantity %></span><form action="/cart/items/<%= item.productId %>/increment" method="post"><button type="submit" aria-label="Increase <%= product.name %> quantity" <%= canIncrement ? '' : 'disabled' %> class="quantity-button">+</button></form></div>
                            <% if (item.availability === 'in-stock' && item.stockQuantity > 0) { %><form action="/cart/items/<%= item.productId %>/quantity" method="post" class="update-quantity"><label>Available: <%= item.stockQuantity %></label><input name="quantity" type="number" value="<%= item.quantity %>" min="1" max="<%= item.stockQuantity %>" aria-label="Quantity for <%= product.name %>"><button type="submit">Update</button></form><% } %></div>
                            <p class="line-total"><span>Line total</span><strong>₹ <%= item.lineTotal.toFixed(2) %></strong></p></div>
                    </div>
                </article>
            <% }) %>
        </section>
        <aside class="summary-card"><h2>Price summary</h2><dl class="summary-lines"><div><dt>Subtotal</dt><dd>₹ <%= totals.subtotal.toFixed(2) %></dd></div><div class="discount-line"><dt>Total discount</dt><dd>− ₹ <%= totals.totalDiscount.toFixed(2) %></dd></div><div class="summary-total"><dt>Total</dt><dd>₹ <%= totals.total.toFixed(2) %></dd></div></dl>
            <% if (items.every(function(item) { return item.available; })) { %><a href="/checkout" class="button button-dark cart-checkout-button">Continue to checkout</a><% } else { %><p class="stock-warning cart-summary-warning">Update unavailable quantities before checkout.</p><% } %>
            <p class="summary-note">Prices use the latest product details. Availability and stock are checked again when you change quantities.</p>
        </aside></div>
    <% } %>
</main>
<%- include('./partials/footer') %>
