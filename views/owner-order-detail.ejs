<%- include('./partials/header') %>
<main id="main-content" class="page-shell shell">
    <a href="/owners/orders" class="inline-link">← All orders</a>
    <div class="page-heading order-title"><div><p class="eyebrow">Owner order management</p><h1>Order #<%= String(order._id).slice(-8).toUpperCase() %></h1></div><span class="status-pill status-<%= order.status %>"><%= order.status %></span></div>
    <% if (error) { %><p role="alert" class="page-alert page-alert-error"><%= error %></p><% } %><% success.forEach(function(message) { %><p role="status" class="page-alert page-alert-success"><%= message %></p><% }) %>
    <div class="order-detail-grid"><section class="order-products" aria-label="Items in this order"><% order.items.forEach(function(item) { %><article class="order-product"><img src="data:<%= item.imageContentType %>;base64,<%= item.image.toString('base64') %>" alt=""><div><h2><%= item.name %></h2><p>Quantity: <%= item.quantity %> · ₹ <%= item.unitPrice.toFixed(2) %> each</p></div><strong>₹ <%= (item.unitPrice * item.quantity).toFixed(2) %></strong></article><% }) %></section>
    <aside class="summary-card"><h2>Fulfilment</h2><address class="delivery-address"><strong><%= order.deliveryAddress.customerName %></strong><br><%= order.deliveryAddress.phone %><br><%= order.deliveryAddress.address %><br><%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %> <%= order.deliveryAddress.postalCode %></address><p class="payment-status">Cash on delivery · Payment <%= order.paymentStatus %></p><p class="order-total">₹ <%= order.total.toFixed(2) %></p>
        <% if (allowedStatuses.length) { %><form action="/owners/orders/<%= order._id %>/status" method="post" class="owner-status-form"><label class="field-label">Update status<select name="status" required><% allowedStatuses.forEach(function(status) { %><option value="<%= status %>"><%= status.charAt(0).toUpperCase() + status.slice(1) %></option><% }) %></select></label><button class="button button-dark" type="submit">Save status</button></form><% } else { %><p class="summary-note">This order is <%= order.status %> and has no further status changes.</p><% } %>
    </aside></div>
</main>
<%- include('./partials/footer') %>
