<%- include('./partials/header') %>
<main class="min-h-screen px-5 pb-16 pt-24 md:px-10"><div class="mx-auto max-w-5xl">
    <a href="/owners/orders" class="text-sm underline">← All orders</a>
    <div class="mb-7 mt-4 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm uppercase tracking-wide text-zinc-500">Owner order management</p><h1 class="text-3xl font-semibold">Order #<%= String(order._id).slice(-8).toUpperCase() %></h1></div><span class="rounded-full bg-zinc-100 px-4 py-2 capitalize"><%= order.status %></span></div>
    <% if (error) { %><p role="alert" class="mb-4 rounded bg-red-100 p-4 text-red-800"><%= error %></p><% } %>
    <% success.forEach(function(message) { %><p role="status" class="mb-4 rounded bg-green-100 p-4 text-green-800"><%= message %></p><% }) %>
    <div class="grid gap-7 lg:grid-cols-[1fr_20rem]"><section class="space-y-3"><% order.items.forEach(function(item) { %><article class="flex gap-4 rounded-lg border bg-white p-4"><img class="h-20 w-20 rounded bg-zinc-50 object-contain p-2" src="data:<%= item.imageContentType %>;base64,<%= item.image.toString('base64') %>" alt=""><div><h2 class="font-medium"><%= item.name %></h2><p class="text-sm text-zinc-600">Qty <%= item.quantity %> · ₹ <%= item.unitPrice.toFixed(2) %> each</p></div></article><% }) %></section>
    <aside class="h-fit rounded-lg border bg-white p-5"><h2 class="font-semibold">Fulfilment</h2><p class="mt-3"><%= order.deliveryAddress.customerName %></p><p><%= order.deliveryAddress.phone %></p><p class="mt-2 text-sm text-zinc-600"><%= order.deliveryAddress.address %>, <%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %> <%= order.deliveryAddress.postalCode %></p><p class="mt-4 text-sm">Cash on delivery · Payment <%= order.paymentStatus %></p><p class="mt-2 text-lg font-semibold">₹ <%= order.total.toFixed(2) %></p>
        <% if (allowedStatuses.length) { %><form action="/owners/orders/<%= order._id %>/status" method="post" class="mt-5 border-t pt-4"><label class="block text-sm">Update status<select class="mt-1 w-full rounded border px-3 py-2" name="status" required><% allowedStatuses.forEach(function(status) { %><option value="<%= status %>"><%= status.charAt(0).toUpperCase() + status.slice(1) %></option><% }) %></select></label><button class="mt-3 w-full rounded-full bg-zinc-900 px-4 py-2 text-white">Save status</button></form><% } else { %><p class="mt-5 border-t pt-4 text-sm text-zinc-600">This order is <%= order.status %> and has no further status changes.</p><% } %>
    </aside></div>
</div></main>
<%- include('./partials/footer') %>
