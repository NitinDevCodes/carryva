<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f8f6f1">
    <title>Carryva — bags for the everyday</title>
    <link rel="stylesheet" href="/css/site.css">
    <script src="/js/site.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
    <div class="announcement">A considered collection of bags for wherever the day takes you</div>
    <div class="header-main shell">
        <details class="mobile-menu">
            <summary aria-label="Open navigation"><span class="menu-lines" aria-hidden="true"></span></summary>
            <nav class="mobile-menu-panel" aria-label="Mobile navigation">
                <a href="/shop">Shop all bags</a>
                <a href="/shop?filter=new">New arrivals</a>
                <a href="/shop?filter=discounted">The edit</a>
                <a href="/?returnTo=%2Forders#account">Sign in / create account</a>
                <a href="/orders">Your orders</a>
            </nav>
        </details>
        <a class="brand" href="/" aria-label="Carryva home">
            <span class="brand-mark" aria-hidden="true">C</span>
            <span class="brand-name">carryva</span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
            <a href="/shop">Shop</a>
            <a href="/shop?filter=new">New arrivals</a>
            <a href="/shop?filter=discounted">The edit</a>
        </nav>
        <nav class="header-actions" aria-label="Your account and shopping bag">
            <a class="header-text-link" href="/?returnTo=%2Fshop#account">Account</a>
            <a class="header-text-link orders-link" href="/orders">Orders</a>
            <a class="cart-link" href="/cart" aria-label="Shopping bag">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.5h11l1 12h-13l1-12Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
                <span class="cart-label">Bag</span>
                <span class="cart-count" id="cart-count" aria-live="polite" aria-atomic="true">0</span>
            </a>
        </nav>
    </div>
</header>
