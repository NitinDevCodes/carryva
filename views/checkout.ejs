<%- include('./partials/header') %>
<main id="main-content" class="page-shell shell">
    <div class="page-heading"><div><p class="eyebrow">Almost yours</p><h1>Checkout</h1><p>Share your delivery details to complete your order.</p></div><a class="inline-link" href="/cart">Back to your bag</a></div>
    <% if (error) { %><p role="alert" class="page-alert page-alert-error"><%= error %></p><% } %>
    <% if (cartItems.length) { %>
        <form action="/checkout/place" method="post" class="checkout-layout">
            <input type="hidden" name="idempotencyKey" value="<%= checkoutKey %>">
            <div class="checkout-form">
                <section class="form-card"><h2>Delivery details</h2><p class="form-hint">Where should we deliver your Carryva bag?</p>
                    <div class="field-grid">
                        <label class="field-label">Customer name<input name="customerName" value="<%= values.customerName || user.fullName %>" minlength="3" maxlength="80" autocomplete="name" required></label>
                        <label class="field-label">Phone number<input name="phone" value="<%= values.phone || '' %>" type="tel" inputmode="tel" autocomplete="tel" required></label>
                        <label class="field-label field-span">Delivery address<textarea name="address" rows="3" minlength="5" maxlength="300" autocomplete="street-address" required><%= values.address || '' %></textarea></label>
                        <label class="field-label">City<input name="city" value="<%= values.city || '' %>" maxlength="80" autocomplete="address-level2" required></label>
                        <label class="field-label">State<input name="state" value="<%= values.state || '' %>" maxlength="80" autocomplete="address-level1" required></label>
                        <label class="field-label">Postal code<input name="postalCode" value="<%= values.postalCode || '' %>" maxlength="12" autocomplete="postal-code" required></label>
                    </div>
                    <fieldset class="payment-fieldset"><legend>Payment method</legend><label class="payment-choice"><input type="radio" name="paymentMethod" value="cash-on-delivery" checked required><span><strong>Cash on delivery</strong><span>Pay when your order arrives. No online payment has been taken.</span></span></label></fieldset>
                </section>
            </div>
            <aside class="summary-card"><h2>Order summary</h2><ul class="checkout-items">
                <% cartItems.forEach(function(item) { %><li class="checkout-item"><img src="data:<%= item.imageContentType %>;base64,<%= item.image.toString('base64') %>" alt=""><div><strong><%= item.name %></strong><p>Qty <%= item.quantity %> · ₹ <%= item.unitPrice.toFixed(2) %> each</p></div><strong>₹ <%= item.lineTotal.toFixed(2) %></strong></li><% }) %>
            </ul><dl class="summary-lines"><div><dt>Subtotal</dt><dd>₹ <%= totals.subtotal.toFixed(2) %></dd></div><div class="discount-line"><dt>Discount</dt><dd>− ₹ <%= totals.discount.toFixed(2) %></dd></div><div><dt>Delivery</dt><dd><%= totals.deliveryFee === 0 ? 'Free' : `₹ ${totals.deliveryFee.toFixed(2)}` %></dd></div><div class="summary-total"><dt>Total due on delivery</dt><dd>₹ <%= totals.total.toFixed(2) %></dd></div></dl>
                <button class="button button-dark cart-checkout-button" type="submit">Place order</button><p class="summary-note">Stock and current prices are verified when you place the order.</p>
            </aside>
        </form>
    <% } else { %><section class="empty-state"><p class="eyebrow">Your bag is waiting</p><h2>Checkout is unavailable</h2><p>Add an available bag to your cart before placing an order.</p><a href="/shop" class="button button-dark">Browse bags</a></section><% } %>
</main>
<%- include('./partials/footer') %>
