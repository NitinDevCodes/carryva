<%- include('./partials/header') %>
<main class="min-h-screen px-6 py-20 md:px-20">
    <div class="mx-auto max-w-4xl">
        <a class="mb-6 inline-block underline" href="/owners/admin">All products</a>
        <% success.forEach(function(message) { %><p class="mb-4 rounded bg-blue-100 p-3 text-blue-800"><%= message %></p><% }) %>
        <% if (error) { %><p class="mb-4 rounded bg-red-100 p-3 text-red-800"><%= error %></p><% } %>
        <main class="rounded bg-white p-8 shadow">
            <h1 class="mb-6 text-xl font-bold"><%= product ? 'Edit product' : 'Create new product' %></h1>
            <form autocomplete="off" action="<%= product ? `/products/${product._id}/update` : '/products/create' %>" method="post" enctype="multipart/form-data">
                <div class="mb-6">
                    <h2 class="mb-2 font-semibold">Product details</h2>
                    <label class="mb-2 block font-medium" for="image">Product image <%= product ? '(optional)' : '' %></label>
                    <input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp" class="mb-4 block py-2" <%= product ? '' : 'required' %>>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <input name="name" type="text" placeholder="Product Name" value="<%= product ? product.name : '' %>" minlength="2" maxlength="120" required class="w-full rounded border p-2">
                        <input name="price" type="number" placeholder="Product Price" value="<%= product ? product.price : '' %>" min="0.01" max="10000000" step="0.01" required class="w-full rounded border p-2">
                        <input name="discount" type="number" placeholder="Discount percent" value="<%= product ? product.discount : 0 %>" min="0" max="100" step="0.01" class="w-full rounded border p-2">
                        <label class="flex items-center gap-2"><input name="isNewCollection" type="checkbox" <%= product && product.isNewCollection ? 'checked' : '' %>> New collection</label>
                    </div>
                </div>
                <div class="mb-6">
                    <h2 class="mb-2 font-semibold">Panel colors</h2>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                        <input name="bgColor" type="text" placeholder="Background color (#f4f4f4)" value="<%= product ? product.bgColor : '#f4f4f4' %>" pattern="(#[0-9a-fA-F]{3,8}|[a-zA-Z]{1,24})" required class="w-full rounded border p-2">
                        <input name="panelColor" type="text" placeholder="Panel color (#ffffff)" value="<%= product ? product.panelColor : '#ffffff' %>" pattern="(#[0-9a-fA-F]{3,8}|[a-zA-Z]{1,24})" required class="w-full rounded border p-2">
                        <input name="textColor" type="text" placeholder="Text color (#111827)" value="<%= product ? product.textColor : '#111827' %>" pattern="(#[0-9a-fA-F]{3,8}|[a-zA-Z]{1,24})" required class="w-full rounded border p-2">
                    </div>
                </div>
                <button class="rounded bg-blue-500 px-5 py-2 text-white" type="submit"><%= product ? 'Save changes' : 'Create product' %></button>
            </form>
        </main>
    </div>
</main>
<%- include('./partials/footer') %>
