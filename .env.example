NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=carryva-rs
MONGODB_DB=Carryva
TRUST_PROXY_HOPS=
JWT_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
EXPRESS_SESSION_SECRET=replace-with-a-different-random-secret-at-least-32-bytes
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
